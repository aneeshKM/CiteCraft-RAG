# Required for embeddings, summaries, and grounded answers
OPENAI_API_KEY=sk-your-key-here

# Local infrastructure (matches compose.yaml)
POSTGRES_URL=postgresql+psycopg://citecraft:citecraft@localhost:6024/citecraft
REDIS_URL=redis://localhost:6379/0
PGVECTOR_COLLECTION=citecraft_documents

# Model and retrieval settings
CHAT_MODEL=gpt-4o-mini
# Store summary and answer outputs in OpenAI for dashboard/API observability
OPENAI_STORE_RESPONSES=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TOP_K=5
PARTITION_STRATEGY=hi_res
MAX_CONTEXT_CHARACTERS=24000
SUMMARY_CONCURRENCY=4
